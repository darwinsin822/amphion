[Desktop Entry]
Name=MintPlayer
GenericName=Reproductor de Spotify
Comment=Reproductor nativo de Spotify ultra ligero para Linux Mint Cinnamon
Exec=/usr/bin/mintplayer %U
Terminal=false
Type=Application
Icon=mintplayer
Categories=AudioVideo;Audio;Player;Music;
Keywords=Spotify;Music;Reproductor;Audio;Cinnamon;
StartupNotify=true
StartupWMClass=mintplayer
Actions=Login;Headless;

[Desktop Action Login]
Name=Iniciar Sesión en Spotify
Exec=/usr/bin/mintplayer --login

[Desktop Action Headless]
Name=Modo Demonio (Segundo plano)
Exec=/usr/bin/mintplayer --daemon
