[Desktop Entry]
Name=Amphion
GenericName=Reproductor de Spotify
Comment=Reproductor de Spotify con temas Amphion y bloqueo de publicidad para Linux Mint Cinnamon
Exec=/usr/bin/amphion %U
Terminal=false
Type=Application
Icon=amphion
Categories=AudioVideo;Audio;Player;Music;
Keywords=Spotify;Music;Reproductor;Audio;Cinnamon;Amphion;
StartupNotify=true
StartupWMClass=amphion
Actions=Login;Headless;

[Desktop Action Login]
Name=Iniciar Sesión en Spotify
Exec=/usr/bin/amphion --login

[Desktop Action Headless]
Name=Modo Demonio (Segundo plano)
Exec=/usr/bin/amphion --daemon
